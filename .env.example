# Public address shown on the site (mailto links, contact section)
VITE_PUBLIC_CONTACT_EMAIL=hello@theactivitylab.xyz

# Server-only inbox for /api/contact (set in Vercel — not bundled into the site)
FORM_INBOX_EMAIL=photospheremedia00@gmail.com

# Resend (same PhotoSphere account as crypto-pay) — server-only, set in Vercel
RESEND_API_KEY=re_...
EMAIL_FROM=The Activity Lab <noreply@cryptopay.sale>

# Optional: local dev when running `vercel dev` (loads api/contact with env above)
# VITE_FORM_INBOX_EMAIL=photospheremedia00@gmail.com
