# Public address shown on the site (mailto links, contact section)
VITE_PUBLIC_CONTACT_EMAIL=hello@theactivitylab.xyz

# Server-only inbox for /api/contact (set in Vercel — not bundled into the site)
FORM_INBOX_EMAIL=your-private-inbox@gmail.com

# Optional: local dev fallback when running `npm run dev` without `vercel dev`
# VITE_FORM_INBOX_EMAIL=your-private-inbox@gmail.com
