# Porkbun API — https://porkbun.com/account/api
# Enable API Access on theactivitylab.xyz → Domain Management → Details
PORKBUN_API_KEY=pk1_your_key_here
PORKBUN_SECRET_API_KEY=sk1_your_secret_here

PORKBUN_DOMAIN=theactivitylab.xyz

# Private inbox for Porkbun email forwarding (hello@theactivitylab.xyz)
PORKBUN_FORWARD_TO=your-private-inbox@gmail.com
